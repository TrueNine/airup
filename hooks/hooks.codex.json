{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${PLUGIN_ROOT}/skills/airup-codex-assets/scripts/airup-codex-assets.ts\" session-start",
            "timeout": 300,
            "statusMessage": "airup: hydrating managed assets, project gitignore and protected branches"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|exec_command|shell_command|shell|exec|unified_exec",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${PLUGIN_ROOT}/hooks/pre-tool-use/prevent-git-push-protected-commit.ts\"",
            "timeout": 10,
            "statusMessage": "airup: checking Git mutation policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${PLUGIN_ROOT}/hooks/post-tool-use/format-edited-files.ts\"",
            "timeout": 30,
            "statusMessage": "airup: formatting edited files"
          }
        ]
      }
    ]
  }
}
