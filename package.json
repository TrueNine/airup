{
  "name": "airup",
  "version": "0.2.39",
  "type": "module",
  "license": "GPL-3.0-only",
  "private": false,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "check:skill-eof": "bun scripts/pre-commit/ensure-skill-eof.ts",
    "check:skill-versions": "bun scripts/pre-commit/check-staged-skill-versions.ts",
    "check:skill-metadata": "bun scripts/check-skill-metadata.ts",
    "sync:versions:staged": "bun scripts/pre-commit/sync-staged-versions.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:mutation": "stryker run stryker.config.ts",
    "test:repository-scripts": "bun test scripts/",
    "test:validators": "bun test skills/airup-dev-tdd/scripts/ skills/airup-ddd-event-storming-design/scripts/ skills/airup-iam-access-control-design/scripts/ skills/airup-dev-bdd/scripts/",
    "typecheck": "bunx tsc --noEmit",
    "format": "bunx biome format --write .",
    "format:check": "bunx biome format .",
    "format:markdown": "bun scripts/pre-commit/format-markdown-codeblocks.ts",
    "format:markdown:staged": "bun scripts/pre-commit/format-markdown-codeblocks.ts --staged",
    "format:markdown:write": "bun scripts/pre-commit/format-markdown-codeblocks.ts --write",
    "lint": "bunx biome check .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@cucumber/cucumber": "^13.2.1",
    "@stryker-mutator/api": "^10.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@types/bun": "^1.4.1",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2"
  }
}
